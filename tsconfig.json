{
  "include": ["app/**/*", "shared/**/*", "server/**/*", "scripts/*.ts", "*.ts", ".react-router/types/**/*"],
  "exclude": ["workers", "app/server/r2-media.ts"],
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2023"], "types": ["node", "vite/client"],
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "rootDirs": [".", "./.react-router/types"], "resolveJsonModule": true, "esModuleInterop": true,
    "verbatimModuleSyntax": true, "strict": true, "skipLibCheck": true, "noEmit": true, "allowImportingTsExtensions": true
  }
}
