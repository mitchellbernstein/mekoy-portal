APP_ORIGIN=http://127.0.0.1:4783
BETTER_AUTH_URL=http://127.0.0.1:4783
# Generate once with openssl rand -base64 48. Preserve this across restarts.
BETTER_AUTH_SECRET=
# Your existing PostgreSQL 17 database with pgvector enabled.
DATABASE_URL=
DEFAULT_ACCOUNT_PLAN=workspace
PORT=4783
HOST=127.0.0.1
MEDIA_ROOT=.local/media
JOBS_AUTORUN=1
# Optional for Node. Real timed Node transcription requires this external key.
DEEPGRAM_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_GATEWAY_ID=
SEARCH_ANSWER_DAILY_LIMIT=20
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
DEMO_RUNNER_TOKEN=
# Optional isolated Node/Docker runner output. Keep retained runs on durable storage.
DEMO_OUTPUT_ROOT=.local/agent-runs
ELEVENLABS_API_KEY=
# Existing resources only. The configuration command does not create resources.
CLOUDFLARE_CONFIG_API_TOKEN=
HYPERDRIVE_ID=
CLOUDFLARE_QUEUE_NAME=
CLOUDFLARE_WORKER_NAME=mekoy-portal
